{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["types/*.d.ts", "ui/js/**/*.js", "ui/renderer/*.js"],
  "exclude": ["ui/vendor", "ui/renderer/vendor"]
}
