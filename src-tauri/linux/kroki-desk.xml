<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kroki Desk's shared-mime-info package, laid down by the .deb in
  /usr/share/mime/packages/ (bundle.linux.deb.files) and merged into the MIME
  database by update-mime-database (dpkg trigger of shared-mime-info, backed up
  by the postinst — cf. linux/postinst.sh).

  This file only carries the native formats: the xtask derives
  linux/kroki-desk.generated.xml from it (gitignored), completed with the types
  specific to the embedded plugins (cf. xtask/src/bundled.rs), and that is the
  one the package installs.

  It is indispensable: the .desktop's MimeType= only declares the types the
  application can open, it says nowhere that a `.kdws` file IS of that type.
  Without the <glob>s below, the application's own formats do not exist for the
  system and a double-click finds no handler.

  Each type is a <sub-class-of> its real form (zip, json, text): this is what
  keeps the generic handlers available, and also what makes the glob win
  against content detection — a `.kdext` really is a zip, and without this
  lineage sniffing would classify it as application/zip.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">

  <mime-type type="application/x-kroki-desk-session">
    <comment>Kroki Desk session</comment>
    <comment xml:lang="fr">Session Kroki Desk</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.kdws"/>
    <icon name="kroki_deskapp"/>
  </mime-type>

  <mime-type type="application/x-kroki-desk-plugin">
    <comment>Kroki Desk plugin archive</comment>
    <comment xml:lang="fr">Archive de plugin Kroki Desk</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.kdext"/>
    <icon name="kroki_deskapp"/>
  </mime-type>

  <!--
    text/markdown already exists upstream, but with *.md, *.mkd and *.markdown
    only (checked in freedesktop.org.xml.in): *.mdown, which DOC_EXTENSIONS
    accepts, is not there. Only the missing glob is added — no <comment>, so
    as not to redefine anything of the standard definition.
  -->
  <mime-type type="text/markdown">
    <glob pattern="*.mdown"/>
  </mime-type>

</mime-info>
