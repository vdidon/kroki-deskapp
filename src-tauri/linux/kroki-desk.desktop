# Handlebars template of the .deb package's .desktop file (bundle.linux.deb.desktopTemplate
# of src-tauri/tauri.deb.conf.json). It replaces the Tauri bundler's for a single
# reason, but a decisive one: the default template writes `Exec={{exec}}` **without an
# argument flag**, so the launcher has nowhere to pass the file —
# double-clicking a document would open the empty application. `%F` (list of local paths,
# not `%U`: the application takes paths, not URLs) is what makes the
# associations operative; everything else is taken from the upstream template.
#
# Variables provided by the bundler: name, comment (optional), exec, icon,
# categories, mime_type (optional, = the mimeTypes of bundle.fileAssociations
# joined by "; "). No others are available — the text outside variables is fixed.
[Desktop Entry]
Type=Application
Version=1.5
Name={{name}}
GenericName=Markdown viewer
GenericName[fr]=Visionneuse Markdown
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
StartupNotify=true
StartupWMClass={{exec}}
Categories={{categories}}
Keywords=markdown;diagram;diagramme;kroki;mermaid;plantuml;graphviz;latex;
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
