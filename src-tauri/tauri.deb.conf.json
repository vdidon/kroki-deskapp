{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "vdidon",
    "category": "Utility",
    "shortDescription": "Markdown viewer with Kroki diagram rendering",
    "longDescription": "Kroki Desk displays Markdown documents and renders Kroki diagram blocks (mermaid, plantuml, graphviz, d2, bpmn, svgbob…) to SVG with no server, no Docker and no network: all the engines are embedded in the executable.\n\nThe PlantUML, C4-PlantUML and ditaa engines run on the JVM and therefore need an installed Java (default-jre is enough); none of the others do.",
    "fileAssociations": [
      {
        "ext": ["kdws"],
        "name": "Kroki Desk session",
        "mimeType": "application/x-kroki-desk-session"
      },
      {
        "ext": ["kdext"],
        "name": "Kroki Desk plugin",
        "mimeType": "application/x-kroki-desk-plugin"
      },
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML document",
        "mimeType": "text/html"
      }
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libc6 (>= 2.36)"],
        "recommends": ["shared-mime-info", "desktop-file-utils", "xdg-utils"],
        "desktopTemplate": "linux/kroki-desk.desktop",
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh",
        "files": {
          "/usr/share/mime/packages/kroki-desk.xml": "linux/kroki-desk.xml"
        }
      }
    }
  }
}
