<?xml version="1.0" encoding="utf-8"?>
<!-- Installer texts, reference language (cf. CLAUDE.md, § "Windows
     installer (MSI)"). Same set of Ids in every language. Tauri's strings
     (TauriLanguage, TauriCodepage) are added by the bundler; the others
     (LaunchApp…) are redefined here so they get translated. No in-house Id
     may contain a Tauri Id: the bundler tests this by substring. -->
<WixLocalization Culture="en-us" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="LaunchApp">Launch Kroki Desk</String>
  <String Id="DowngradeErrorMessage">A newer version of Kroki Desk is already installed.</String>
  <String Id="PathEnvVarFeature">Add the install location of the Kroki Desk executable to the PATH system environment variable. This allows the Kroki Desk executable to be called from any location.</String>
  <String Id="InstallAppFeature">Installs Kroki Desk.</String>

  <String Id="KdPluginDlgDescription">Choose the plugins to install with the application.</String>
  <String Id="KdPluginDlgHeading">Install with Kroki Desk</String>
  <String Id="KdPluginDlgHint">A plugin adds file formats the application cannot read on its own.</String>
  <String Id="KdPluginDlgNote">Ticked plugins are installed on first launch and updated with the application. Kroki Desk becomes the default application for their formats, unless you have already chosen another one.</String>

  <String Id="KdProgIdSession">Kroki Desk session</String>
  <String Id="KdProgIdPlugin">Kroki Desk plugin</String>
  <String Id="KdProgIdDocument">Kroki Desk document</String>
</WixLocalization>
