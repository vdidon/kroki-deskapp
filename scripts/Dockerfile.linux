# Linux build/test image for Kroki Desk (Tauri 2 + WebKitGTK).
# Used to validate compilation of the #[cfg(not(windows))] fallbacks on a Linux
# target AND the real rendering of the WASM/JS engines under WebKitGTK
# (headless via Xvfb).
#
# Usage (from the repo root):
#   docker build -t kroki-linux-build -f scripts/Dockerfile.linux .
#   # Compile only:
#   docker run --rm -v ${PWD}:/app -v kroki_target:/target -v kroki_cargo:/usr/local/cargo/registry \
#     -e CARGO_TARGET_DIR=/target kroki-linux-build cargo build
#   # Build + engine runtime test (the app runs headless, POST to the local API):
#   docker run --rm -v ${PWD}:/app -v kroki_target:/target -v kroki_cargo:/usr/local/cargo/registry \
#     kroki-linux-build bash /app/scripts/linux_runtime_run.sh
#   # Standalone AppImage (Tauri bundler, tauri.appimage.conf.json overlay) → dist/:
#   # (the kroki_cache volume persists ~/.cache/tauri: linuxdeploy/appimagetool are
#   #  downloaded only once — otherwise GitHub ends up rate-limiting with a 429)
#   docker run --rm -v ${PWD}:/app -v kroki_target:/target -v kroki_cargo:/usr/local/cargo/registry \
#     -v kroki_cache:/root/.cache kroki-linux-build bash /app/scripts/linux_appimage_build.sh
#   # Debian/Ubuntu package (Tauri bundler, tauri.deb.conf.json overlay) → dist/:
#   # (no tool downloaded, hence no cache volume to mount)
#   docker run --rm -v ${PWD}:/app -v kroki_target:/target -v kroki_cargo:/usr/local/cargo/registry \
#     kroki-linux-build bash /app/scripts/linux_deb_build.sh
#   # Runtime test of the produced AppImage (instead of the debug binary):
#   docker run --rm -e APP="/app/dist/Kroki Desk_<version>_amd64.AppImage" \
#     -v ${PWD}:/app -v kroki_target:/target -v kroki_cargo:/usr/local/cargo/registry \
#     kroki-linux-build bash /app/scripts/linux_runtime_run.sh
#
# NB (Windows/Git Bash): run these commands from PowerShell — Git Bash
# rewrites the /app/... paths into C:/Program Files/Git/app/... (MSYS pathconv).
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    pkg-config \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Runtime dependencies for the headless test (separate layer → cache preserved).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xauth \
    dbus-x11 \
    libgl1-mesa-dri \
    libgles2 \
    nodejs \
    curl \
    && rm -rf /var/lib/apt/lists/*

# AppImage tooling (see linux_appimage_build.sh): tauri-cli compiled from
# crates.io (long, ~10 min — layer placed BEFORE the apt utilities so that
# adding a package does not invalidate this compilation), then the utilities
# required by linuxdeploy and its plugins (downloaded by the bundler on the
# first build; xdg-utils: the GTK plugin calls xdg-open).
RUN cargo install tauri-cli --version '^2' --locked
RUN apt-get update && apt-get install -y --no-install-recommends \
    file \
    wget \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/src-tauri
